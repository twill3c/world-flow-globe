{
  "name": "world-flow-globe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "世界の港・海洋境界・推定航路・チョークポイントを 3D 地球儀に重ね、閉鎖の what-if をブラウザ内で計算する",
  "scripts": {
    "dev": "vite",
